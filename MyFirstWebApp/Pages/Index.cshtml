@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow mt-5">
            <div class="card-body">

                <h2 class="text-center mb-4">Регистрация на мероприятие</h2>

                <!-- Форма -->
                <form method="post" asp-page-handler="Add">

                    <div class="mb-3">
                        <label class="form-label">Имя</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Возраст</label>
                        <input asp-for="Age" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Любимый предмет</label>
                        <input asp-for="Subject" class="form-control" />
                    </div>
                    
                    @* Домашка *@
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Класс</label>
                        <input asp-for="ClassName" class="form-control" />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            Зарегистрироваться
                        </button>
                    </div>

                </form>

                <!-- Ошибка -->
                @if (Model.Error != null)
                {
                    <div class="alert alert-danger mt-3">
                        @Model.Error
                    </div>
                }

                <!-- Успех -->
                @if (Model.Name != null && Model.Error == null)
                {
                    <div class="alert alert-success mt-3">
                        <h5>Вы успешно зарегистрированы!</h5>
                        <p><b>Имя:</b> @Model.Name</p>
                        <p><b>Возраст:</b> @Model.Age</p>
                        <p><b>Любимый предмет:</b> @Model.Subject</p>
                        @* Домашка *@
                        <p><b>Email:</b> @Model.Email</p>
                        <p><b>Класс:</b> @Model.ClassName</p>
                    </div>
                }

            </div>
        </div>

        @if (IndexModel.Participants.Count > 0)
        {
            <div class="mt-5">
                <h3 class="text-center">Список участников</h3>

                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>№</th>
                            <th>Имя</th>
                            <th>Возраст</th>
                            <th>Предмет</th>
                            @* Домашка *@
                            <th>Email</th>
                            <th>Класс</th>
                            <th>Действие</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < IndexModel.Participants.Count; i++)
                        {
                            var p = IndexModel.Participants[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@p.Name</td>
                                <td>@p.Age</td>
                                <td>@p.Subject</td>
                                @* Домашка *@
                                <td>@p.Email</td>
                                <td>@p.ClassName</td>
                                <td>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="deleteIndex" value="@i" />
                                        <button class="btn btn-danger btn-sm">
                                            Удалить
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>