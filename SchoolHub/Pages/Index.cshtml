@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-warning">
                    @Model.Message
                </div>
            }

            @if (Model.IsAuthorized)
            {
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h2 class="mb-3">Здравствуйте, @Model.CurrentUserName!</h2>

                        <p class="mb-1">
                            <strong>Логин:</strong> @Model.CurrentUserLogin
                        </p>

                        <p class="mb-3">
                            <strong>Возраст:</strong> @Model.CurrentUserAge
                        </p>

                        <form method="post" asp-page-handler="Logout">
                            <button type="submit" class="btn btn-danger">
                                Выйти
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-body">
                        <h2 class="text-center mb-4">Добро пожаловать</h2>

                        <ul class="nav nav-tabs mb-3" id="authTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active"
                                        id="login-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#login"
                                        type="button"
                                        role="tab">
                                    Вход
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link"
                                        id="register-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#register"
                                        type="button"
                                        role="tab">
                                    Регистрация
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="login" role="tabpanel">
                                <form method="post" asp-page-handler="Login">
                                    <div class="mb-3">
                                        <label class="form-label">Логин</label>
                                        <input asp-for="LoginLogin" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Пароль</label>
                                        <input asp-for="LoginPassword" type="password" class="form-control" />
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100">
                                        Войти
                                    </button>
                                </form>
                            </div>

                            <div class="tab-pane fade" id="register" role="tabpanel">
                                <form method="post" asp-page-handler="Register">
                                    <div class="mb-3">
                                        <label class="form-label">Имя</label>
                                        <input asp-for="RegisterName" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Возраст</label>
                                        <input asp-for="RegisterAge" type="number" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Логин</label>
                                        <input asp-for="RegisterLogin" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Пароль</label>
                                        <input asp-for="RegisterPassword" type="password" class="form-control" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Подтверждение пароля</label>
                                        <input asp-for="RegisterConfirmPassword" type="password" class="form-control" />
                                    </div>

                                    <button type="submit" class="btn btn-success w-100">
                                        Зарегистрироваться
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
