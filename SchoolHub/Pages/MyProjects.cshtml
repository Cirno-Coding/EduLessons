@page
@model SchoolHub.Pages.MyProjectsModel
@{
    ViewData["Title"] = "Мои проекты";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Мои проекты</h1>
            <p class="text-muted mb-0">Пользователь: @Model.CurrentUserName</p>
        </div>

        <span class="badge bg-success fs-6">Моих проектов: @Model.MyProjectsCount</span>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <div class="alert alert-info">
            У вас пока нет проектов.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h4 class="card-title">@project.Title</h4>

                            <p class="mb-2">
                                <span class="badge bg-primary">@project.Category</span>
                            </p>

                            <p class="card-text">@project.Description</p>
                        </div>

                        <div class="card-footer">
                            <small class="d-block text-muted mb-2">
                                Дата создания: @project.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </small>

                            <div class="d-flex gap-2">
                                <a asp-page="/EditProject"
                                   asp-route-id="@project.Id"
                                   class="btn btn-warning btn-sm">
                                    Редактировать
                                </a>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@project.Id">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>